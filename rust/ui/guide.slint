import { ScrollView } from "std-widgets.slint";
import { Action, SemanticPill } from "controls.slint";
import { Palette } from "theme.slint";

export struct GuideCard { heading: string, badge: string, tone: string, body: string, example: string }
export struct GuideSection { title: string, subtitle: string, cards: [GuideCard] }

export component Guide inherits VerticalLayout {
    in property <[GuideSection]> sections;
    property <int> selected: 0;
    property <GuideSection> current: root.sections.length > 0 ? root.sections[root.selected] : { title: "", subtitle: "", cards: [] };
    spacing: 12px;

    HorizontalLayout {
        spacing: 4px;
        for section[i] in root.sections : Action {
            tab: true;
            label: section.title;
            primary: i == root.selected;
            clicked => {
                root.selected = i;
                guide-scroll.viewport-y = 0px;
            }
        }
    }

    Rectangle {
        vertical-stretch: 1;
        background: Palette.surface-alt;
        border-radius: 7px;
        VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text {
                text: root.current.subtitle;
                color: Palette.fg;
                font-size: 20px;
                font-weight: 650;
                wrap: word-wrap;
            }
            guide-scroll := ScrollView {
                vertical-stretch: 1;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, cards.preferred-height);
                cards := VerticalLayout {
                    width: guide-scroll.visible-width;
                    height: self.preferred-height;
                    padding-right: 8px;
                    padding-bottom: 4px;
                    spacing: 10px;
                    for card in root.current.cards : Rectangle {
                        preferred-height: card-layout.preferred-height;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.border;
                        border-radius: 7px;
                        card-layout := VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                Text {
                                    text: card.heading;
                                    font-size: 14px;
                                    font-weight: 650;
                                    color: Palette.fg;
                                    vertical-alignment: center;
                                }
                                if card.badge != "" : SemanticPill { text: card.badge; tone: card.tone; }
                            }
                            Text {
                                text: card.body;
                                font-size: 13px;
                                color: Palette.fg;
                                wrap: word-wrap;
                            }
                            if card.example != "" : Text {
                                text: card.example;
                                font-size: 12.5px;
                                color: Palette.accent;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
