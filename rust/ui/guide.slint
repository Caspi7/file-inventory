import { ScrollView } from "std-widgets.slint";
import { Action } from "controls.slint";
import { Palette } from "theme.slint";

export struct GuideSection { title: string, subtitle: string, body: string }

export component Guide inherits VerticalLayout {
    in property <[GuideSection]> sections;
    property <int> selected: 0;
    property <GuideSection> current: root.sections.length > 0 ? root.sections[root.selected] : { title: "", subtitle: "", body: "" };
    spacing: 12px;

    HorizontalLayout {
        spacing: 4px;
        for section[i] in root.sections : Action {
            tab: true;
            label: section.title;
            primary: i == root.selected;
            clicked => { root.selected = i; }
        }
    }

    Rectangle {
        vertical-stretch: 1;
        background: Palette.surface-alt;
        border-radius: 7px;
        VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text {
                text: root.current.subtitle;
                color: Palette.fg;
                font-size: 20px;
                font-weight: 650;
                wrap: word-wrap;
            }
            guide-scroll := ScrollView {
                vertical-stretch: 1;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, guide-text.preferred-height + 16px);
                guide-text := Text {
                    x: 2px; y: 2px;
                    width: max(100px, guide-scroll.visible-width - 16px);
                    text: root.current.body;
                    color: Palette.fg;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
