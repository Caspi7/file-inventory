import { ListView } from "std-widgets.slint";
import { Palette } from "theme.slint";

export struct DataRow { a: string, b: string, c: string, d: string, e: string, f: string, g: string, icon-kind: string, status-tone: string }
export struct TreeRow { title: string, depth: int, marker: string, kind: string }
export struct Tile { x: float, y: float, w: float, h: float, label: string, detail: string, tint: color }
export struct UiChip { label: string, token: string, tone: string }

export component Label inherits Text {
    color: Palette.fg;
    vertical-alignment: center;
    overflow: elide;
}
export component ItemIcon inherits Rectangle {
    in property <string> kind;
    property <bool> folder: kind == "folder";
    property <bool> drive: kind == "drive-online" || kind == "drive-offline" || kind == "drive-imported";
    width: 13px; height: 13px;
    if folder : Image {
        width: 13px; height: 13px;
        source: @image-url("icons/item-folder.svg");
    }
    if !folder : Image {
        width: 13px; height: 13px;
        source: drive ? @image-url("icons/item-drive.svg") : @image-url("icons/item-file.svg");
        colorize: kind == "drive-online" ? Palette.drive : kind == "drive-offline" ? Palette.warning
            : kind == "drive-imported" || kind == "code" ? Palette.imported
            : kind == "pdf" ? Palette.danger : kind == "sheet" ? Palette.success
            : kind == "doc" ? Palette.accent : kind == "media" ? Palette.warning
            : kind == "archive" ? Palette.teal : Palette.muted;
    }
}

export component SemanticPill inherits Rectangle {
    in property <string> text;
    in property <string> tone;
    in property <bool> dot;
    in property <length> max-pill-width: 166px;
    property <bool> is-blue: tone == "accent" || tone == "info" || tone == "blue" || tone == "drive";
    property <bool> is-teal: tone == "teal";
    property <color> ink: tone == "success" ? Palette.success : tone == "warning" ? Palette.warning
        : tone == "danger" ? Palette.danger : is-blue ? (Palette.dark ? Palette.drive : Palette.accent)
        : is-teal ? Palette.teal : Palette.imported;
    width: min(pill-text.preferred-width + (dot ? 29px : 16px), max-pill-width);
    height: 22px;
    border-radius: self.height / 2;
    background: tone == "success" ? Palette.success-bg : tone == "warning" ? Palette.warning-bg
        : tone == "danger" ? Palette.danger-bg : is-blue ? (Palette.dark ? #152c44 : #e0f2fe)
        : is-teal ? (Palette.dark ? #113235 : #ccfbf1) : Palette.imported-bg;
    if root.dot : Rectangle {
        x: 8px; y: (parent.height - self.height) / 2;
        width: 6px; height: 6px; border-radius: 3px; background: root.ink;
    }
    pill-text := Label {
        x: root.dot ? 21px : 8px; width: parent.width - self.x - 8px;
        height: parent.height; text: root.text; color: root.ink; horizontal-alignment: center;
    }
}

export component ChipPill inherits Rectangle {
    in property <string> text;
    in property <string> tone: "accent";
    callback clicked;
    property <bool> is-blue: tone == "accent" || tone == "info" || tone == "blue" || tone == "drive";
    property <bool> is-teal: tone == "teal";
    property <color> ink: tone == "success" ? Palette.success : tone == "warning" ? Palette.warning
        : tone == "danger" ? Palette.danger : is-blue ? (Palette.dark ? Palette.drive : Palette.accent)
        : is-teal ? Palette.teal : Palette.imported;
    width: min(chip-label.preferred-width + 20px, 240px);
    height: 22px;
    border-radius: 11px;
    border-width: 1px;
    border-color: hit.has-hover ? root.ink : transparent;
    background: tone == "success" ? Palette.success-bg : tone == "warning" ? Palette.warning-bg
        : tone == "danger" ? Palette.danger-bg : is-blue ? (Palette.dark ? #152c44 : #e0f2fe)
        : is-teal ? (Palette.dark ? #113235 : #ccfbf1) : Palette.imported-bg;
    chip-label := Label {
        x: 10px; width: parent.width - 20px; height: parent.height;
        text: root.text; color: root.ink; horizontal-alignment: center;
    }
    hit := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component Action inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <color> icon-tint: transparent;
    in property <length> horizontal-padding: 9px;
    in property <string> tone: "";
    property <color> tone-ink: tone == "danger" ? Palette.danger : tone == "success" ? Palette.success
        : tone == "warning" ? Palette.warning : tone == "accent" ? Palette.accent : transparent;
    property <bool> toned: enabled && !primary && tone-ink != Colors.transparent;
    in property <bool> primary;
    in property <bool> tab;
    in property <bool> enabled: true;
    out property <bool> hovered: pointer.has-hover;
    callback clicked;
    min-width: line.preferred-width;
    height: tab ? 36px : 30px;
    border-width: 1px;
    border-color: primary && enabled ? Palette.accent : keyboard.has-focus ? Palette.accent : toned ? tone-ink : Palette.border;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: tab ? 0px : 6px;
    border-bottom-right-radius: tab ? 0px : 6px;
    background: primary && enabled ? (pointer.pressed ? Palette.accent-pressed : pointer.has-hover ? Palette.accent-hover : Palette.accent)
        : toned && pointer.has-hover && tone != "accent"
            ? (tone == "danger" ? Palette.danger-bg : tone == "success" ? Palette.success-bg : Palette.warning-bg)
        : enabled && pointer.pressed ? Palette.surface-pressed : enabled && pointer.has-hover ? Palette.surface-hover : Palette.surface;
    line := HorizontalLayout {
        padding-left: root.horizontal-padding;
        padding-right: root.horizontal-padding;
        spacing: 5px;
        if root.icon != "" : Image {
            width: 14px; height: 14px; y: (parent.height - self.height) / 2;
            source: root.icon == "M2 3H14V11H2Z M5 13H11 M6 6L8 8L10 6" ? @image-url("icons/scope.svg")
                : root.icon == "M2 4H14V12H2Z M4 9H11 M11 6H12" ? @image-url("icons/scan.svg")
                : root.icon == "M4 4L12 12 M12 4L4 12" ? @image-url("icons/close.svg")
                : root.icon == "M2 7L5 4H12L14 6 M2 7V3 M14 9L11 12H4L2 10 M14 9V13" ? @image-url("icons/sync.svg")
                : root.icon == "M8 1V4 M8 12V15 M1 8H4 M12 8H15 M3 3L5 5 M11 11L13 13 M3 13L5 11 M11 5L13 3 M8 4A4 4 0 1 0 8 12A4 4 0 1 0 8 4" ? @image-url("icons/settings.svg")
                : root.icon == "M2 3H14V7H2Z M2 9H14V13H2Z M11 5H12 M11 11H12" ? @image-url("icons/drives.svg")
                : root.icon == "M2 2H10V10H2Z M6 11V14H14V6H11" ? @image-url("icons/copy.svg")
                : root.icon == "M3 2H13V14H3Z M5 5H11 M5 8H11 M5 11H9" ? @image-url("icons/changes.svg")
                : root.icon == "M11 7A4 4 0 1 0 3 7A4 4 0 1 0 11 7 M10 10L14 14" ? @image-url("icons/search.svg")
                : root.icon == "M8 2V10 M4 6L8 10L12 6 M2 11V14H14V11" ? @image-url("icons/update.svg")
                : root.icon == "M11 2A6 6 0 1 0 14 11A6 6 0 0 1 11 2" ? @image-url("icons/theme.svg")
                : root.icon == "M2 8H4 M7 8H9 M12 8H14" ? @image-url("icons/more.svg")
                : root.icon == "M5 5C5 1 12 1 12 5C12 8 8 8 8 11 M8 13V15" ? @image-url("icons/help.svg")
                : root.icon == "M3 8L8 3L13 8 M8 3V14" ? @image-url("icons/up.svg")
                : root.icon == "M8 1L10 6L15 6L11 9L13 14L8 11L3 14L5 9L1 6L6 6Z" ? @image-url("icons/star.svg")
                : root.icon == "M1 4H6L8 6H15L13 13H1Z" ? @image-url("icons/reveal.svg")
                : @image-url("icons/trash.svg");
            colorize: root.primary && root.enabled ? white : !root.enabled ? Palette.disabled-fg : root.toned ? root.tone-ink
                : root.icon-tint != Colors.transparent ? root.icon-tint : Palette.fg;
        }
        if root.label != "" : Label {
            text: root.label;
            color: root.primary && root.enabled ? white : !root.enabled ? Palette.disabled-fg : root.toned && root.icon == "" ? root.tone-ink : Palette.fg;
            horizontal-alignment: center;
        }
    }
    keyboard := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    pointer := TouchArea {
        enabled: root.enabled; mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

export component Meter inherits Rectangle {
    in property <float> value;
    height: 5px;
    border-radius: 3px;
    background: Palette.track-bg;
    Rectangle {
        width: root.width * min(1, max(0, root.value)); height: parent.height;
        border-radius: 3px; background: Palette.accent;
    }
}

component Cells inherits HorizontalLayout {
    in property <DataRow> cells;
    in property <DataRow> headers;
    in property <string> column-mode;
    in property <color> ink: Palette.fg;
    in property <bool> header;
    in property <bool> selected;
    in property <int> sort-column;
    in property <bool> sort-ascending;
    callback sort(int);
    property <bool> main: column-mode == "main";
    property <bool> deep: column-mode == "deep";
    property <[string]> titles: main ? [headers.a, headers.b, headers.c, headers.d, headers.e, headers.f, headers.g]
        : deep ? [headers.a, headers.b, headers.c, headers.f, headers.d, headers.e]
        : headers.d != "" ? [headers.a, headers.b, headers.c, headers.d] : [headers.a, headers.b, headers.c];
    property <[string]> values: deep
        ? [cells.a, cells.b, cells.c, cells.f, cells.d, cells.e, cells.g]
        : [cells.a, cells.b, cells.c, cells.d, cells.e, cells.f, cells.g];
    property <[length]> widths: main ? [200px, 64px, 140px, 145px, 94px, 86px, 132px]
        : deep ? [205px, 145px, 180px, 86px, 84px, 132px, 0px]
        : [150px, 110px, 100px, 100px, 128px, 0px, 0px];
    padding-left: 8px; padding-right: 22px; spacing: 8px;
    for title[i] in root.titles : cell := Rectangle {
        clip: true;
        min-width: root.widths[i];
        max-width: i == 2 ? 10000px : root.widths[i];
        preferred-width: i == 2 ? 0px : root.widths[i];
        horizontal-stretch: i == 2 ? 1 : 0;
        property <bool> sortable: root.header && (root.main || root.deep);
        background: sortable && sort-hit.has-hover ? Palette.surface-hover : transparent;
        property <bool> show-icon: !root.header && i == 0 && root.cells.icon-kind != "";
        property <bool> show-status: !root.header && !root.selected && root.cells.status-tone != "" && root.values[i] != ""
            && ((root.main && i == 4) || (root.deep && i == 3) || (root.column-mode == "changes" && i == 0));
        if cell.show-icon : ItemIcon {
            x: 0px; y: (parent.height - self.height) / 2; kind: root.cells.icon-kind;
        }
        if cell.show-status : SemanticPill {
            x: 0px; y: (parent.height - self.height) / 2;
            text: root.values[i]; tone: root.cells.status-tone; max-pill-width: parent.width;
        }
        if !cell.show-status : Label {
            x: cell.show-icon ? 19px : 0px; width: parent.width - self.x; height: parent.height;
            text: root.header ? title + (root.sort-column == i ? (root.sort-ascending ? " ▲" : " ▼") : "") : root.values[i];
            color: root.ink;
            wrap: no-wrap; overflow: elide; vertical-alignment: center;
            horizontal-alignment: (root.main && i >= 5) || (root.deep && i >= 4) ? right : left;
        }
        sort-hit := TouchArea {
            enabled: parent.sortable;
            mouse-cursor: pointer;
            clicked => { root.sort(i); }
        }
    }
}

export component Grid inherits VerticalLayout {
    in property <[DataRow]> rows;
    in property <DataRow> headers;
    in property <string> column-mode: "main";
    in property <int> sort-column: -1;
    in property <bool> sort-ascending: true;
    in-out property <int> selection: -1;
    callback sort(int);
    callback selected(int);
    callback activated(int);
    property <length> table-width: max(items.visible-width, column-mode == "main" ? 939px : column-mode == "deep" ? 902px : headers.d != "" ? 514px : 406px);
    Rectangle {
        height: 29px; background: Palette.header-bg; clip: true;
        Cells {
            x: items.viewport-x; width: root.table-width; height: parent.height;
            headers: root.headers; column-mode: root.column-mode; ink: Palette.muted;
            header: true; sort-column: root.sort-column; sort-ascending: root.sort-ascending;
            sort(i) => { root.sort(i); }
        }
        Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
    }
    items := ListView {
        viewport-width: root.table-width;
        for row[i] in root.rows : Rectangle {
            width: root.table-width; height: 29px; clip: true;
            background: i == root.selection ? Palette.accent-pressed : hit.has-hover ? Palette.surface-hover : mod(i, 2) == 0 ? Palette.surface : Palette.surface-alt;
            Cells { cells: row; headers: root.headers; column-mode: root.column-mode; selected: i == root.selection; ink: i == root.selection ? white : Palette.fg; }
            hit := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selection = i; root.selected(i); }
                double-clicked => { root.activated(i); }
            }
        }
    }
}
